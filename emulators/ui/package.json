{
  "name": "emulator-ui",
  "version": "0.1.0",
  "private": true,
  "description": "The generic browser UI of hakkas' emulators: draws what an emulator describes over its control protocol",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build --force && vite build",
    "type-check": "vue-tsc --build --force",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "vue": "3.5.11"
  },
  "devDependencies": {
    "@playwright/test": "1.47.2",
    "@tsconfig/node20": "20.1.4",
    "@types/node": "22.7.4",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/tsconfig": "0.5.1",
    "typescript": "~5.6.2",
    "vite": "5.4.19",
    "vitest": "2.1.9",
    "vue-tsc": "2.1.6",
    "ws": "8.22.0",
    "@types/ws": "8.18.1"
  }
}
