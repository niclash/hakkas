{
  "extends": "@tsconfig/node20/tsconfig.json",
  "include": [
    "env.d.ts",
    "src/components/protocols/**/*.ts",
    "src/components/model.ts",
    "src/theme.ts",
    "src/session.ts",
    "src/address.ts",
    "src/components/floweditor/selection/blocks.ts",
    "src/components/inspector.ts",
    "src/components/renaming.ts",
    "src/components/initials.ts",
    "src/components/floweditor/value-position.ts",
    "src/components/floweditor/menus.ts",
    "src/components/floweditor/port-layout.ts",
    "src/components/palette.ts",
    "src/components/processes.ts",
    "src/components/watches.ts",
    "src/components/composite.ts",
    "src/components/clipboard.ts",
    "src/components/roles.ts",
    "src/components/messages.ts",
    "src/components/undo.ts",
    "src/components/bindings.ts",
    "tests/**/*",
    "vitest.config.*",
    "playwright.config.*"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  }
}
