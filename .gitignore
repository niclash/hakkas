# Build trees (CMake presets build into build/<preset>; CLion's default is cmake-build-*)
/build/
/cmake-build-*/

# Left behind by a refused in-source configure (`cmake .`)
/CMakeCache.txt
/CMakeFiles/

# Local, machine-specific CMake presets
/CMakeUserPresets.json

# IDE / tooling state
/.idea/
/.vscode/
/.cache/
/compile_commands.json

# ./build-debug.sh output: the engine, the frontend, and their configuration and data
/dist-debug/
