root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = tab
tab_width = 8
max_line_length = 100

[{CMakeLists.txt,*.cmake,*.json,*.yml,*.yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Vendored code keeps its upstream formatting.
[third_party/**]
indent_style = unset
indent_size = unset
tab_width = unset
max_line_length = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
